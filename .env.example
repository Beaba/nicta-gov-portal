# Copy to .env and fill in real values for any capability you want to run in production mode.
# The application runs fully in mock mode with NO values set below beyond DATABASE_URL and
# SESSION_SECRET. See docs/deployment-guide.md.

# --- Core -------------------------------------------------------------
# PostgreSQL connection string. Matches docker-compose.yml's "db" service by default. Host port is
# 5433, not the Postgres default 5432, because this dev machine already runs an unrelated
# project's Postgres container on 5432 — see docs/known-limitations.md.
DATABASE_URL="postgresql://nicta:nicta_dev_password@localhost:5433/nicta_portal?schema=public"

# Random 32+ character secret used to sign/encrypt the session cookie (iron-session).
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-character-minimum-secret-value"

# Base URL the app is served from (used to build absolute links in notifications/emails).
APP_BASE_URL="http://localhost:3000"

# --- Authentication -----------------------------------------------------
# "mock" (default) | "entra"
AUTH_PROVIDER="mock"

# Required only when AUTH_PROVIDER=entra. See docs/entra-id-registration-guide.md.
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Must exactly match a redirect URI registered on the Entra app. Port below is the Next.js
# default (3000) — on a machine where that port is taken (this dev machine included; `next dev`
# falls back to 3001, watch its startup log), update this to match, e.g.
# "http://localhost:3001/api/auth/entra/callback".
AZURE_AD_REDIRECT_URI="http://localhost:3000/api/auth/entra/callback"

# --- Microsoft Graph / SharePoint / Microsoft Lists ----------------------
# "local" (default, filesystem under .data/documents) | "sharepoint"
DOCUMENT_STORAGE_PROVIDER="local"
# "database" (default, authoritative per docs/assumptions-and-decisions.md#A7) | "microsoft-lists"
KANBAN_PROVIDER="database"

# Required only when DOCUMENT_STORAGE_PROVIDER=sharepoint or KANBAN_PROVIDER=microsoft-lists.
# See docs/graph-permissions-guide.md and docs/sharepoint-provisioning-guide.md.
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_TENANT_ID=""
SHAREPOINT_SITE_ID=""
SHAREPOINT_DRIVE_ID=""
MICROSOFT_LISTS_WORKPLAN_LIST_ID=""
MICROSOFT_LISTS_ACTIVITY_LIST_ID=""

# --- Closed internal AI service ------------------------------------------
# "mock" (default, deterministic local summaries) | "internal"
AI_PROVIDER="mock"

# Required only when AI_PROVIDER=internal. See docs/ai-integration-contract.md.
INTERNAL_AI_ENDPOINT=""
INTERNAL_AI_MODEL_NAME=""
INTERNAL_AI_API_KEY=""

# --- Notifications ---------------------------------------------------------
# "mock" (default, stored in-app only) | "graph" (Outlook/Teams via Microsoft Graph)
NOTIFICATION_PROVIDER="mock"

# --- Deadlines ---------------------------------------------------------------
DEFAULT_TIMEZONE="Pacific/Port_Moresby"
