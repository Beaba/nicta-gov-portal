// NICTA Internal Management and Board Submission Portal — data model.
// See docs/data-model.md for an entity-relationship narrative and
// docs/assumptions-and-decisions.md for the reasoning behind modelling choices
// (in particular A4, A5, A6, A7, A9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference data (admin-configurable — never hardcoded in application logic)
// ---------------------------------------------------------------------------

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  userRoles   UserRole[]
  workplans   Workplan[]
  submissions Submission[]
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // MANAGER | DIRECTOR | SMC_SECRETARIAT | SMC_MEMBER | BOARD_SECRETARIAT | EXECUTIVE_VIEWER | SYSTEM_ADMIN
  name        String
  description String?

  userRoles UserRole[]
}

model StrategicObjective {
  id            String  @id @default(cuid())
  code          String  @unique
  title         String
  description   String?
  financialYear String
  isActive      Boolean @default(true)

  workplans  Workplan[]
  activities Activity[]
}

model ReportingPeriod {
  id         String   @id @default(cuid())
  code       String   @unique // e.g. FY2026-Q1
  label      String
  periodType String // Monthly | Quarterly | Custom
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(true)

  updates ActivityUpdate[]
}

// Client requirement: "Make the list configurable so Board paper types and other documents can be
// added later. Do not hard-code these throughout the application." Mirrors the Department/Role
// reference-data pattern (#A4). `name` is the display string stored verbatim on
// Submission.paperType (kept as a free string there — see that field's comment — so adding a
// PaperType row never requires a Submission migration). Seeded with only the 3 Milestone 1 types;
// src/lib/config/paperTypes.ts keeps the fuller SMC/Board lists as the documented next-phase
// expansion set.
model PaperType {
  id                     String   @id @default(cuid())
  code                   String   @unique
  name                   String
  category               SubmissionCategory
  isActive               Boolean  @default(true)
  requiresRecommendation Boolean  @default(false)
  createdAt              DateTime @default(now())
}

model Template {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  category      String // ManagementReport | SMCPaper | BoardPaper
  paperType     String? // specific paper type this version is approved for, e.g. "SMC Decision Paper" — see docs/milestone-1-plan.md
  filePath      String // path/storage key of the (placeholder) docx
  isPlaceholder Boolean  @default(true)
  isActive      Boolean  @default(true) // false once superseded — see #A14, never overwritten in place
  effectiveDate DateTime @default(now())
  version       Int      @default(1)
  uploadedAt    DateTime @default(now())
  uploadedById  String?

  supersedesId String?    @unique
  supersedes   Template?  @relation("TemplateVersion", fields: [supersedesId], references: [id])
  supersededBy Template?  @relation("TemplateVersion")

  reviewResults AIReviewResult[]
  submissions   Submission[]
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  entraObjectId String?  @unique
  employeeId    String?  @unique
  name          String
  email         String   @unique
  jobTitle      String?
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  isActive      Boolean  @default(true)
  isDemoUser    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles                        UserRole[]
  responsibleActivities        Activity[]
  workplansAsDirector          Workplan[]       @relation("WorkplanDirector")
  workplansAsManager           Workplan[]       @relation("WorkplanManager")
  activityUpdatesSubmitted     ActivityUpdate[]
  submissionsCreated           Submission[]     @relation("SubmissionCreatedBy")
  submissionsAsSponsorDirector Submission[]     @relation("SubmissionSponsorDirector")
  submissionsAsResponsibleMgr  Submission[]     @relation("SubmissionSponsorManager")
  evidenceUploaded             Evidence[]
  auditEvents                  AuditEvent[]
  notifications                Notification[]
}

model UserRole {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  @@unique([userId, roleId, departmentId])
}

// ---------------------------------------------------------------------------
// Workplans and activities (Kanban)
// ---------------------------------------------------------------------------

enum WorkplanApprovalStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model Workplan {
  id                     String   @id @default(cuid())
  financialYear          String
  departmentId           String
  department             Department          @relation(fields: [departmentId], references: [id])
  title                  String
  strategicObjectiveId   String?
  strategicObjective     StrategicObjective? @relation(fields: [strategicObjectiveId], references: [id])
  corporatePlanReference String?
  directorId             String?
  director               User?               @relation("WorkplanDirector", fields: [directorId], references: [id])
  managerId              String?
  manager                User?               @relation("WorkplanManager", fields: [managerId], references: [id])
  reportingPeriod        String // e.g. "Quarterly" — free label, actual periods are ReportingPeriod rows
  approvalStatus         WorkplanApprovalStatus @default(DRAFT)
  version                Int      @default(1)
  createdAt              DateTime @default(now())
  approvedAt             DateTime?

  activities Activity[]
  reports    ManagementReport[]
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Fixed, code-level workflow (not admin-configurable reference data) — see
// docs/assumptions-and-decisions.md#A5 for why this differs from Department/Role.
enum KanbanStage {
  NOT_STARTED
  PLANNED
  IN_PROGRESS
  AT_RISK
  BLOCKED
  PENDING_REVIEW
  COMPLETED
  DEFERRED
  CANCELLED
}

model Activity {
  id                   String    @id @default(cuid())
  referenceNumber      String    @unique
  workplanId           String
  workplan             Workplan  @relation(fields: [workplanId], references: [id])
  title                String
  description          String?
  strategicObjectiveId String?
  strategicObjective   StrategicObjective? @relation(fields: [strategicObjectiveId], references: [id])
  expectedOutput       String?
  performanceIndicator String?
  target               String?
  baseline             String?
  startDate            DateTime?
  dueDate              DateTime?
  priority             ActivityPriority @default(MEDIUM)
  responsibleOfficerId String?
  responsibleOfficer   User?      @relation(fields: [responsibleOfficerId], references: [id])
  supportingOfficers   String? // free text list of names — see assumptions-and-decisions.md#A6
  percentComplete      Int        @default(0)
  status               KanbanStage @default(NOT_STARTED)
  budgetAllocation     Decimal?   @db.Decimal(14, 2)
  actualExpenditure    Decimal?   @db.Decimal(14, 2)
  dependencies         String?
  risksIssues          String?
  mitigation           String?
  latestAchievement    String?
  nextAction           String?
  createdAt            DateTime   @default(now())
  lastUpdatedAt         DateTime  @updatedAt

  updates     ActivityUpdate[]
  evidence    Evidence[]
  transitions WorkflowTransition[]
}

enum ReviewStatus {
  PENDING
  APPROVED
  RETURNED
}

model ActivityUpdate {
  id                    String   @id @default(cuid())
  activityId            String
  activity              Activity @relation(fields: [activityId], references: [id])
  reportingPeriodId     String
  reportingPeriod       ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  progressPercent       Int
  workCompleted         String
  keyAchievements       String?
  deliverablesProduced  String?
  challenges            String?
  risks                 String?
  mitigation            String?
  nextPeriodActions     String?
  supportRequired       String?
  submittedById         String
  submittedBy           User     @relation(fields: [submittedById], references: [id])
  submittedAt           DateTime @default(now())
  directorReviewStatus  ReviewStatus @default(PENDING)
  directorReviewComment String?
  reviewedById          String?
  reviewedAt            DateTime?
  version               Int      @default(1)
  supersedesId          String?  @unique
  supersedes            ActivityUpdate? @relation("UpdateVersion", fields: [supersedesId], references: [id])
  supersededBy          ActivityUpdate? @relation("UpdateVersion")

  evidence Evidence[]
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED_MOCK
}

// Distinguishes what part of a submission's document set a file represents — lets the routed
// document bundle (client requirement: "Final main paper, Original source paper, Approved
// annexures, AI review report, Human-review record") be queried directly. Annexures are modelled
// separately via SubmissionAnnexure (ordered, carry-forward to Board); EvidenceRole.ANNEXURE
// exists for the general Activity-evidence case and ad-hoc submission attachments outside that
// ordered set.
enum EvidenceRole {
  MAIN_PAPER
  ANNEXURE
  GENERATED_DRAFT
  AI_REVIEW_REPORT
  HUMAN_REVIEW_RECORD
  OTHER
}

model Evidence {
  id               String    @id @default(cuid())
  fileName         String
  storageKey       String
  contentType      String
  sizeBytes        Int
  uploadedById     String
  uploadedBy       User      @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime  @default(now())
  activityId       String?
  activity         Activity? @relation(fields: [activityId], references: [id])
  activityUpdateId String?
  activityUpdate   ActivityUpdate? @relation(fields: [activityUpdateId], references: [id])
  submissionId     String?
  submission       Submission? @relation(fields: [submissionId], references: [id])
  role             EvidenceRole @default(OTHER)
  scanStatus       ScanStatus @default(PENDING)
}

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------

model ManagementReport {
  id                   String   @id @default(cuid())
  workplanId           String
  workplan             Workplan @relation(fields: [workplanId], references: [id])
  reportingPeriodId    String
  templateId           String?
  title                String
  generatedAt          DateTime @default(now())
  generatedById        String
  docxStorageKey       String?
  pdfStorageKey        String?
  aiExecutiveSummary   String?
  aiGenerationRecordId String?
}

// ---------------------------------------------------------------------------
// Meetings and deadlines
// ---------------------------------------------------------------------------

enum MeetingType {
  SMC
  BOARD
}

enum MeetingStatus {
  SCHEDULED
  AGENDA_PREPARED
  PACK_PREPARED
  HELD
  CLOSED
  CANCELLED
}

model Meeting {
  id            String   @id @default(cuid())
  meetingType   MeetingType
  title         String
  meetingNumber String
  meetingDate   DateTime
  timezone      String   @default("Pacific/Port_Moresby")
  status        MeetingStatus @default(SCHEDULED)

  deadline    Deadline?
  submissions Submission[]
  decisions   Decision[]
}

model Deadline {
  id                       String   @id @default(cuid())
  meetingId                String   @unique
  meeting                  Meeting  @relation(fields: [meetingId], references: [id])
  submissionOpenAt         DateTime
  normalCloseAt            DateTime
  lateCloseAt              DateTime
  timezone                 String   @default("Pacific/Port_Moresby")
  permittedPaperTypes      String // JSON-encoded string[] — see assumptions-and-decisions.md#A9
  requiredReviewers        String? // JSON-encoded string[]
  reminderScheduleNote     String? // free text describing reminder offsets (e.g. "T-7d, T-2d, T-1d")
}

// ---------------------------------------------------------------------------
// Reference numbering
// ---------------------------------------------------------------------------

// Backs atomic reference-number allocation (src/lib/submissions/referenceNumber.ts) — `scope` is
// e.g. "SMC-2026", incremented inside a transaction so concurrent submissions never collide.
// See #A14 for why this exists instead of COUNT(*) + 1.
model SequenceCounter {
  scope String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// SMC and Board submissions
// ---------------------------------------------------------------------------

enum SubmissionCategory {
  SMC
  BOARD
}

enum ConfidentialityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

model Submission {
  id                       String   @id @default(cuid())
  referenceNumber          String   @unique
  submissionCategory       SubmissionCategory
  paperType                String // validated against config list per category — see src/lib/config/paperTypes.ts
  title                    String
  departmentId             String
  department               Department @relation(fields: [departmentId], references: [id])
  createdById              String // Milestone 1 Submitter — owns "My Submissions" listing and edit/resubmit rights, see #A14
  createdBy                User     @relation("SubmissionCreatedBy", fields: [createdById], references: [id])
  currentVersion           Int      @default(1) // mirrors versions.length, kept denormalized for quick list/detail display
  sponsoringDirectorId     String?
  sponsoringDirector       User?    @relation("SubmissionSponsorDirector", fields: [sponsoringDirectorId], references: [id])
  responsibleManagerId     String?
  responsibleManager       User?    @relation("SubmissionSponsorManager", fields: [responsibleManagerId], references: [id])
  meetingId                String?
  meeting                  Meeting? @relation(fields: [meetingId], references: [id])
  confidentiality          ConfidentialityLevel @default(INTERNAL)
  purpose                  String?
  executiveSummary         String?
  recommendation           String?
  proposedDecision         String?
  financialImplications    String?
  legalImplications        String?
  riskImplications         String?
  technologyImplications   String?
  stakeholderImplications  String?
  previousReferences       String?
  proposedResolution       String? // required before submission for Board Decision Papers — enforced in code
  workflowStatus           String // see src/lib/workflow/{smc,board}Workflow.ts for the state machine
  isLate                   Boolean  @default(false)
  lateJustification        String?
  lateCannotWaitReason     String?
  lateOperationalImpact    String?
  lateUrgency              String?
  lateExceptionApproverId  String?
  lateExceptionApprovedAt  DateTime?
  sourceWorkplanId         String?
  sourceManagementReportId String?
  smcSourceSubmissionId    String?  @unique
  smcSourceSubmission      Submission? @relation("SmcToBoard", fields: [smcSourceSubmissionId], references: [id])
  boardSubmission          Submission? @relation("SmcToBoard")
  // Milestone 1 fields — see docs/milestone-1-plan.md and #A14.
  mainDocumentStorageKey   String? // the Evidence(role: MAIN_PAPER) storageKey, denormalized for quick lookup
  mainDocumentFileName     String?
  generatedDraftStorageKey String? // set only if a templated draft was generated; never replaces mainDocumentStorageKey
  templateId               String?
  template                 Template? @relation(fields: [templateId], references: [id])
  routingFolderKey         String? // computed destination folder, confirmed/recorded when ACCEPTED -> ROUTED
  routedAt                 DateTime?
  // SEMC's decision that this paper should proceed to Board — see docs/mvp-directors-portal-plan.md#A18.
  // This is NOT the Board paper itself: it only unlocks the Director's ability to submit one (a
  // separate Submission, category BOARD, linked via smcSourceSubmissionId below). Independent of
  // the ACCEPTED -> ROUTED -> CLOSED chain above — not a competing state.
  endorsedForBoard         Boolean  @default(false)
  endorsedForBoardAt       DateTime?
  endorsedForBoardById     String?
  submittedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  versions       SubmissionVersion[]
  annexures      SubmissionAnnexure[]
  reviews        SubmissionReview[]
  decisions      Decision[]
  evidence       Evidence[]
  transitions    WorkflowTransition[]
  aiReviewResults AIReviewResult[]
  actionItems     ActionItem[]
}

model SubmissionVersion {
  id            String     @id @default(cuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id])
  versionNumber Int
  snapshotJson  String // JSON snapshot of submission fields at this version
  createdAt     DateTime   @default(now())
  createdById   String
}

model SubmissionAnnexure {
  id                      String     @id @default(cuid())
  submissionId            String
  submission              Submission @relation(fields: [submissionId], references: [id])
  title                   String
  storageKey              String
  order                   Int        @default(0)
  carriedFromSubmissionId String? // set when transferred from the source SMC submission to a Board submission
}

model SubmissionReview {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  reviewerId   String
  reviewerRole String
  outcome      String // Accepted | Returned | Deferred | Rejected | Noted | Endorsed | EndorsedForBoard | Approved | ReferredBack | Closed
  comments     String?
  createdAt    DateTime   @default(now())
}

model WorkflowTransition {
  id            String      @id @default(cuid())
  entityType    String // Activity | Submission
  activityId    String?
  activity      Activity?   @relation(fields: [activityId], references: [id])
  submissionId  String?
  submission    Submission? @relation(fields: [submissionId], references: [id])
  fromState     String
  toState       String
  performedById String
  performedAt   DateTime    @default(now())
  comment       String?
}

model Decision {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id])
  decisionType String // Noted | Endorsed | Deferred | Rejected | EndorsedForBoard | Approved | ReferredBack | Closed
  decisionDate DateTime
  recordedById String
  notes        String?

  resolutions Resolution[]
  actionItems ActionItem[]
}

model Resolution {
  id               String   @id @default(cuid())
  decisionId       String
  decision         Decision @relation(fields: [decisionId], references: [id])
  resolutionNumber String   @unique
  resolutionText   String
  adoptedAt        DateTime @default(now())
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  OVERDUE
}

model ActionItem {
  id           String   @id @default(cuid())
  decisionId   String?
  decision     Decision?   @relation(fields: [decisionId], references: [id])
  // Direct link so the CEO/Corporate Secretary can attach an action item straight to a paper
  // without first recording a formal Decision — see docs/mvp-directors-portal-plan.md#A18.
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])
  createdById  String?
  description  String
  ownerId      String?
  dueDate      DateTime?
  status       ActionItemStatus @default(OPEN)
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Notifications, audit, AI
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Append-only by convention: application code never issues UPDATE/DELETE against
// this table. See src/lib/audit/auditLog.ts.
model AuditEvent {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String?
  previousState  String? // JSON
  newState       String? // JSON
  correlationRef String?
  createdAt      DateTime @default(now())
}

// Milestone 1 closed-AI template-review output (src/lib/providers/aiReview/). Deliberately a
// separate model from AIGenerationRecord below — see #A14 — because this is structured
// review data (missing sections / warnings / suggested corrections as JSON arrays, a
// human-review status) rather than free-text generated prose. Advisory only: the AI never sets
// Submission.workflowStatus.
enum AIReviewOverallResult {
  PASS
  PASS_WITH_WARNINGS
  FAIL
}

model AIReviewResult {
  id                  String   @id @default(cuid())
  submissionId        String
  submission          Submission @relation(fields: [submissionId], references: [id])
  templateId          String?
  template            Template? @relation(fields: [templateId], references: [id])
  overallResult       AIReviewOverallResult
  missingSections     String // JSON string[]
  warnings            String // JSON string[]
  suggestedCorrections String // JSON string[]
  sourceReferences    String? // JSON string[] — e.g. section/heading names the findings cite
  reviewedAt          DateTime @default(now())
  providerMode        String // mock | internal — see src/lib/providers/aiReview/interface.ts
  modelIdentifier     String? // set only when providerMode = internal
  humanReviewStatus   String   @default("PENDING") // PENDING | ACKNOWLEDGED — reviewer has seen these findings
}

model AIGenerationRecord {
  id            String    @id @default(cuid())
  purpose       String // ExecutiveSummary | BoardPaperSummary | CompletenessCheck | AchievementGrouping
  sourceType    String // Workplan | Activity | ManagementReport | Submission
  sourceIds     String // JSON array of source record ids the text was generated from
  generatedText String
  generatedAt   DateTime  @default(now())
  providerMode  String // mock | internal
  reviewedById  String?
  reviewStatus  String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED
  reviewedAt    DateTime?
}
