// NICTA Internal Management and Board Submission Portal — data model.
// See docs/data-model.md for an entity-relationship narrative and
// docs/assumptions-and-decisions.md for the reasoning behind modelling choices
// (in particular A4, A5, A6, A7, A9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference data (admin-configurable — never hardcoded in application logic)
// ---------------------------------------------------------------------------

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                       User[]
  userRoles                   UserRole[]
  workplans                   Workplan[]
  submissions                 Submission[]
  delegationsAsSupportingDept Delegation[]            @relation("DelegationSupportingDepartment")
  resolutionsAsResponsible    Resolution[]
  actionItemsAsResponsible    ActionItem[]
  performanceSnapshots        DepartmentPerformance[]
  milestones                  Milestone[]
  weeklyReports               WeeklyManagerReport[]
  directorSummaries           DirectorSummary[]
  memos                       Memo[]
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique // MANAGER | DIRECTOR | SMC_SECRETARIAT | SMC_MEMBER | BOARD_SECRETARIAT | EXECUTIVE_VIEWER | SYSTEM_ADMIN
  name        String
  description String?

  userRoles UserRole[]
}

model StrategicObjective {
  id            String  @id @default(cuid())
  code          String  @unique
  title         String
  description   String?
  financialYear String
  isActive      Boolean @default(true)

  workplans  Workplan[]
  activities Activity[]
}

model ReportingPeriod {
  id         String   @id @default(cuid())
  code       String   @unique // e.g. FY2026-Q1
  label      String
  periodType String // Monthly | Quarterly | Custom
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(true)

  updates               ActivityUpdate[]
  departmentPerformance DepartmentPerformance[]
  weeklyReports         WeeklyManagerReport[]
  directorSummaries     DirectorSummary[]
}

// #A31 — a minimal per-department-per-period performance snapshot backing the CEO Dashboard's KPI/
// KRA figures and traffic-light table. Deliberately NOT the full Corporate Strategy -> Corporate
// Plan -> Org KPI -> Dept KPI -> Activity -> Update -> Evidence -> Report hierarchy the client's
// earlier spec described (#A29's known-limitations entry) — that is a real Manager-weekly-update
// collection pipeline this snapshot does not attempt to replace. This table is the *destination*
// a future pipeline would write into; for now it is populated by seed data only, clearly labelled
// as demo figures — see prisma/seed.ts and docs/known-limitations.md.
model DepartmentPerformance {
  id                String          @id @default(cuid())
  departmentId      String
  department        Department      @relation(fields: [departmentId], references: [id])
  reportingPeriodId String
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  kpiPercent        Int
  kraPercent        Int
  overdueActivities Int             @default(0)
  criticalRisks     Int             @default(0)
  lastReportedAt    DateTime?
  recordedById      String?
  createdAt         DateTime        @default(now())

  @@unique([departmentId, reportingPeriodId])
}

// Client requirement: "Make the list configurable so Board paper types and other documents can be
// added later. Do not hard-code these throughout the application." Mirrors the Department/Role
// reference-data pattern (#A4). `name` is the display string stored verbatim on
// Submission.paperType (kept as a free string there — see that field's comment — so adding a
// PaperType row never requires a Submission migration). Seeded with only the 3 Milestone 1 types;
// src/lib/config/paperTypes.ts keeps the fuller SMC/Board lists as the documented next-phase
// expansion set.
model PaperType {
  id                     String             @id @default(cuid())
  code                   String             @unique
  name                   String
  category               SubmissionCategory
  isActive               Boolean            @default(true)
  requiresRecommendation Boolean            @default(false)
  createdAt              DateTime           @default(now())
}

model Template {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  category      String // ManagementReport | SMCPaper | BoardPaper
  paperType     String? // specific paper type this version is approved for, e.g. "SMC Decision Paper" — see docs/milestone-1-plan.md
  filePath      String // path/storage key of the (placeholder) docx
  isPlaceholder Boolean  @default(true)
  isActive      Boolean  @default(true) // false once superseded — see #A14, never overwritten in place
  effectiveDate DateTime @default(now())
  version       Int      @default(1)
  uploadedAt    DateTime @default(now())
  uploadedById  String?

  supersedesId String?   @unique
  supersedes   Template? @relation("TemplateVersion", fields: [supersedesId], references: [id])
  supersededBy Template? @relation("TemplateVersion")

  reviewResults AIReviewResult[]
  submissions   Submission[]
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id            String      @id @default(cuid())
  entraObjectId String?     @unique
  employeeId    String?     @unique
  name          String
  email         String      @unique
  jobTitle      String?
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  isActive      Boolean     @default(true)
  isDemoUser    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  roles                        UserRole[]
  responsibleActivities        Activity[]
  workplansAsDirector          Workplan[]            @relation("WorkplanDirector")
  workplansAsManager           Workplan[]            @relation("WorkplanManager")
  activityUpdatesSubmitted     ActivityUpdate[]
  submissionsCreated           Submission[]          @relation("SubmissionCreatedBy")
  submissionsAsSponsorDirector Submission[]          @relation("SubmissionSponsorDirector")
  submissionsAsResponsibleMgr  Submission[]          @relation("SubmissionSponsorManager")
  evidenceUploaded             Evidence[]
  auditEvents                  AuditEvent[]
  notifications                Notification[]
  delegationsCreated           Delegation[]          @relation("DelegationCreatedBy")
  delegationsAsDirector        Delegation[]          @relation("DelegationDirector")
  delegationsAsSupportingMgr   Delegation[]          @relation("DelegationSupportingManager")
  delegationRecipientRows      DelegationRecipient[]
  milestonesAsResponsible      Milestone[]           @relation("MilestoneResponsibleDirector")
  weeklyReportsAsManager       WeeklyManagerReport[] @relation("WeeklyReportManager")
  directorSummariesAsDirector  DirectorSummary[]     @relation("DirectorSummaryDirector")
  memosAsOriginator            Memo[]                @relation("MemoOriginatingDirector")
  memosAsDelegatedReviewer     Memo[]                @relation("MemoDelegatedReviewer")
  appointmentsOrganised        Appointment[]         @relation("AppointmentOrganiser")
  appointmentInvitations       AppointmentInvitee[]
  reportAccessGrantsReceived   ReportAccessGrant[]   @relation("ReportAccessGrantedTo")
}

model UserRole {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  @@unique([userId, roleId, departmentId])
}

// ---------------------------------------------------------------------------
// Workplans and activities (Kanban)
// ---------------------------------------------------------------------------

enum WorkplanApprovalStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model Workplan {
  id                     String                 @id @default(cuid())
  financialYear          String
  departmentId           String
  department             Department             @relation(fields: [departmentId], references: [id])
  title                  String
  strategicObjectiveId   String?
  strategicObjective     StrategicObjective?    @relation(fields: [strategicObjectiveId], references: [id])
  corporatePlanReference String?
  directorId             String?
  director               User?                  @relation("WorkplanDirector", fields: [directorId], references: [id])
  managerId              String?
  manager                User?                  @relation("WorkplanManager", fields: [managerId], references: [id])
  reportingPeriod        String // e.g. "Quarterly" — free label, actual periods are ReportingPeriod rows
  approvalStatus         WorkplanApprovalStatus @default(DRAFT)
  version                Int                    @default(1)
  createdAt              DateTime               @default(now())
  approvedAt             DateTime?

  activities Activity[]
  reports    ManagementReport[]
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Fixed, code-level workflow (not admin-configurable reference data) — see
// docs/assumptions-and-decisions.md#A5 for why this differs from Department/Role.
enum KanbanStage {
  NOT_STARTED
  PLANNED
  IN_PROGRESS
  AT_RISK
  BLOCKED
  PENDING_REVIEW
  COMPLETED
  DEFERRED
  CANCELLED
}

model Activity {
  id                   String              @id @default(cuid())
  referenceNumber      String              @unique
  workplanId           String
  workplan             Workplan            @relation(fields: [workplanId], references: [id])
  title                String
  description          String?
  strategicObjectiveId String?
  strategicObjective   StrategicObjective? @relation(fields: [strategicObjectiveId], references: [id])
  expectedOutput       String?
  performanceIndicator String?
  target               String?
  baseline             String?
  startDate            DateTime?
  dueDate              DateTime?
  priority             ActivityPriority    @default(MEDIUM)
  responsibleOfficerId String?
  responsibleOfficer   User?               @relation(fields: [responsibleOfficerId], references: [id])
  supportingOfficers   String? // free text list of names — see assumptions-and-decisions.md#A6
  percentComplete      Int                 @default(0)
  status               KanbanStage         @default(NOT_STARTED)
  budgetAllocation     Decimal?            @db.Decimal(14, 2)
  actualExpenditure    Decimal?            @db.Decimal(14, 2)
  dependencies         String?
  risksIssues          String?
  mitigation           String?
  latestAchievement    String?
  nextAction           String?
  createdAt            DateTime            @default(now())
  lastUpdatedAt        DateTime            @updatedAt

  updates       ActivityUpdate[]
  evidence      Evidence[]
  transitions   WorkflowTransition[]
  weeklyReports WeeklyManagerReport[]
}

enum ReviewStatus {
  PENDING
  APPROVED
  RETURNED
}

model ActivityUpdate {
  id                    String          @id @default(cuid())
  activityId            String
  activity              Activity        @relation(fields: [activityId], references: [id])
  reportingPeriodId     String
  reportingPeriod       ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  progressPercent       Int
  workCompleted         String
  keyAchievements       String?
  deliverablesProduced  String?
  challenges            String?
  risks                 String?
  mitigation            String?
  nextPeriodActions     String?
  supportRequired       String?
  submittedById         String
  submittedBy           User            @relation(fields: [submittedById], references: [id])
  submittedAt           DateTime        @default(now())
  directorReviewStatus  ReviewStatus    @default(PENDING)
  directorReviewComment String?
  reviewedById          String?
  reviewedAt            DateTime?
  version               Int             @default(1)
  supersedesId          String?         @unique
  supersedes            ActivityUpdate? @relation("UpdateVersion", fields: [supersedesId], references: [id])
  supersededBy          ActivityUpdate? @relation("UpdateVersion")

  evidence Evidence[]
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED_MOCK
}

// Distinguishes what part of a submission's document set a file represents — lets the routed
// document bundle (client requirement: "Final main paper, Original source paper, Approved
// annexures, AI review report, Human-review record") be queried directly. Annexures are modelled
// separately via SubmissionAnnexure (ordered, carry-forward to Board); EvidenceRole.ANNEXURE
// exists for the general Activity-evidence case and ad-hoc submission attachments outside that
// ordered set.
enum EvidenceRole {
  MAIN_PAPER
  ANNEXURE
  GENERATED_DRAFT
  AI_REVIEW_REPORT
  HUMAN_REVIEW_RECORD
  OTHER
}

model Evidence {
  id               String               @id @default(cuid())
  fileName         String
  storageKey       String
  contentType      String
  sizeBytes        Int
  uploadedById     String
  uploadedBy       User                 @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime             @default(now())
  activityId       String?
  activity         Activity?            @relation(fields: [activityId], references: [id])
  activityUpdateId String?
  activityUpdate   ActivityUpdate?      @relation(fields: [activityUpdateId], references: [id])
  submissionId     String?
  submission       Submission?          @relation(fields: [submissionId], references: [id])
  delegationId     String?
  delegation       Delegation?          @relation(fields: [delegationId], references: [id])
  // #A32 — additive evidence attachment points for the new CEO Portal modules. Reuses this one
  // polymorphic-by-FK Evidence model rather than a separate attachments table per new module,
  // matching this codebase's existing convention (Activity/ActivityUpdate/Submission/Delegation
  // above).
  milestoneId      String?
  milestone        Milestone?           @relation(fields: [milestoneId], references: [id])
  weeklyReportId   String?
  weeklyReport     WeeklyManagerReport? @relation(fields: [weeklyReportId], references: [id])
  memoId           String?
  memo             Memo?                @relation(fields: [memoId], references: [id])
  appointmentId    String?
  appointment      Appointment?         @relation(fields: [appointmentId], references: [id])
  role             EvidenceRole         @default(OTHER)
  scanStatus       ScanStatus           @default(PENDING)
}

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------

model ManagementReport {
  id                   String   @id @default(cuid())
  workplanId           String
  workplan             Workplan @relation(fields: [workplanId], references: [id])
  reportingPeriodId    String
  templateId           String?
  title                String
  generatedAt          DateTime @default(now())
  generatedById        String
  docxStorageKey       String?
  pdfStorageKey        String?
  aiExecutiveSummary   String?
  aiGenerationRecordId String?
}

// ---------------------------------------------------------------------------
// Meetings and deadlines
// ---------------------------------------------------------------------------

enum MeetingType {
  SMC
  BOARD
}

// SCHEDULED/AGENDA_PREPARED/PACK_PREPARED/HELD/CLOSED/CANCELLED are the original SMC-meeting
// vocabulary (#A9-era). DRAFT/PUBLISHED/IN_PROGRESS/COMPLETED/ARCHIVED were added for #A30's Board
// Dashboard — the client's spec names exactly these 5 as the Board meeting status set, and
// "Published" specifically gates Board Member visibility (a Board Member must never see a meeting
// the Secretariat hasn't published yet), which none of the original 6 values map to cleanly. Kept
// as one enum (additive, non-breaking) rather than a second parallel type — SMC meetings keep using
// the original 6 values, Board meetings use the new 5; see #A30's decision log entry.
enum MeetingStatus {
  SCHEDULED
  AGENDA_PREPARED
  PACK_PREPARED
  HELD
  CLOSED
  CANCELLED
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Meeting {
  id            String        @id @default(cuid())
  meetingType   MeetingType
  title         String
  meetingNumber String
  meetingDate   DateTime
  venue         String? // "Venue or meeting link" (#A30) — free text covers both a physical room and a video-call URL
  timezone      String        @default("Pacific/Port_Moresby")
  status        MeetingStatus @default(SCHEDULED)

  deadline    Deadline?
  submissions Submission[]
  decisions   Decision[]
  agendaItems MeetingAgendaItem[]
  attendance  MeetingAttendance[]
  minutes     MeetingMinutes[]
  resolutions Resolution[]
  actionItems ActionItem[]
}

// #A30 — one ordered row per Board meeting agenda item, optionally linked to the Board paper it
// covers. A plain ordered list (not a tree/section hierarchy) — the client's spec describes agenda
// items as a flat, reorderable set, not nested sections.
model MeetingAgendaItem {
  id           String      @id @default(cuid())
  meetingId    String
  meeting      Meeting     @relation(fields: [meetingId], references: [id])
  order        Int
  title        String
  description  String?
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  resolutions Resolution[]
}

// #A30 — one row per Board Member per meeting. Recorded by the Secretariat, read by everyone with
// meeting access.
model MeetingAttendance {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id])
  userId     String
  status     String // ATTENDED | APOLOGY | ABSENT
  recordedAt DateTime @default(now())

  @@unique([meetingId, userId])
}

// #A30 — draft/under-review/published minutes for a Board meeting. Multiple rows per meeting are
// allowed (each upload is a new version, append-only — #A6/#A27's convention — rather than
// overwriting a single row) with `version` incrementing; the highest-version row is the current one.
model MeetingMinutes {
  id           String    @id @default(cuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id])
  version      Int       @default(1)
  status       String    @default("DRAFT") // DRAFT | UNDER_REVIEW | PUBLISHED
  storageKey   String
  fileName     String
  uploadedById String
  uploadedAt   DateTime  @default(now())
  publishedAt  DateTime?
}

// #A30 — polymorphic comment thread, same generalization pattern already established by AuditEvent
// (entityType/entityId rather than a separate comments table per commentable model). Replies are a
// self-relation via parentId. `visibility` controls whether Corporate Secretariat can see a
// Board-only remark — the client's spec explicitly distinguishes "Board-only visibility" from
// "Secretariat visibility".
model Comment {
  id         String    @id @default(cuid())
  entityType String // Submission | Resolution | ActionItem | MeetingMinutes
  entityId   String
  authorId   String
  parentId   String?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  body       String
  visibility String    @default("BOARD_AND_SECRETARIAT") // BOARD_ONLY | BOARD_AND_SECRETARIAT
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model Deadline {
  id                   String   @id @default(cuid())
  meetingId            String   @unique
  meeting              Meeting  @relation(fields: [meetingId], references: [id])
  submissionOpenAt     DateTime
  normalCloseAt        DateTime
  lateCloseAt          DateTime
  timezone             String   @default("Pacific/Port_Moresby")
  permittedPaperTypes  String // JSON-encoded string[] — see assumptions-and-decisions.md#A9
  requiredReviewers    String? // JSON-encoded string[]
  reminderScheduleNote String? // free text describing reminder offsets (e.g. "T-7d, T-2d, T-1d")
  // #A32 — SEMC reporting-window fields the Corporate Secretariat configures alongside the existing
  // open/close dates, mirroring permittedPaperTypes' JSON-string-column convention (#A9) rather than
  // a normalized join table, for the same "keep meeting-configuration schema simple" reasoning.
  requiredDepartments  String? // JSON-encoded string[] of Department codes
  requiredAnnexures    String? // JSON-encoded string[] of required annexure labels
}

// ---------------------------------------------------------------------------
// Reference numbering
// ---------------------------------------------------------------------------

// Backs atomic reference-number allocation (src/lib/submissions/referenceNumber.ts) — `scope` is
// e.g. "SMC-2026", incremented inside a transaction so concurrent submissions never collide.
// See #A14 for why this exists instead of COUNT(*) + 1.
model SequenceCounter {
  scope String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// SMC and Board submissions
// ---------------------------------------------------------------------------

enum SubmissionCategory {
  SMC
  BOARD
}

enum ConfidentialityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

model Submission {
  id                            String               @id @default(cuid())
  referenceNumber               String               @unique
  submissionCategory            SubmissionCategory
  paperType                     String // validated against config list per category — see src/lib/config/paperTypes.ts
  title                         String
  departmentId                  String
  department                    Department           @relation(fields: [departmentId], references: [id])
  createdById                   String // Milestone 1 Submitter — owns "My Submissions" listing and edit/resubmit rights, see #A14
  createdBy                     User                 @relation("SubmissionCreatedBy", fields: [createdById], references: [id])
  currentVersion                Int                  @default(1) // mirrors versions.length, kept denormalized for quick list/detail display
  sponsoringDirectorId          String?
  sponsoringDirector            User?                @relation("SubmissionSponsorDirector", fields: [sponsoringDirectorId], references: [id])
  responsibleManagerId          String?
  responsibleManager            User?                @relation("SubmissionSponsorManager", fields: [responsibleManagerId], references: [id])
  meetingId                     String?
  meeting                       Meeting?             @relation(fields: [meetingId], references: [id])
  confidentiality               ConfidentialityLevel @default(INTERNAL)
  purpose                       String?
  executiveSummary              String?
  recommendation                String?
  proposedDecision              String?
  financialImplications         String?
  legalImplications             String?
  riskImplications              String?
  technologyImplications        String?
  stakeholderImplications       String?
  previousReferences            String?
  proposedResolution            String? // required before submission for Board Decision Papers — enforced in code
  workflowStatus                String // see src/lib/workflow/{smc,board}Workflow.ts for the state machine
  isLate                        Boolean              @default(false)
  lateJustification             String?
  lateCannotWaitReason          String?
  lateOperationalImpact         String?
  lateUrgency                   String?
  lateExceptionApproverId       String?
  lateExceptionApprovedAt       DateTime?
  sourceWorkplanId              String?
  sourceManagementReportId      String?
  smcSourceSubmissionId         String?              @unique
  smcSourceSubmission           Submission?          @relation("SmcToBoard", fields: [smcSourceSubmissionId], references: [id])
  boardSubmission               Submission?          @relation("SmcToBoard")
  // Milestone 1 fields — see docs/milestone-1-plan.md and #A14.
  mainDocumentStorageKey        String? // the Evidence(role: MAIN_PAPER) storageKey, denormalized for quick lookup
  mainDocumentFileName          String?
  generatedDraftStorageKey      String? // set only if a templated draft was generated; never replaces mainDocumentStorageKey
  templateId                    String?
  template                      Template?            @relation(fields: [templateId], references: [id])
  routingFolderKey              String? // computed destination folder, confirmed/recorded when ACCEPTED -> ROUTED
  routedAt                      DateTime?
  // SEMC's decision that this paper should proceed to Board — see docs/mvp-directors-portal-plan.md#A18.
  // This is NOT the Board paper itself: it only unlocks the Director's ability to submit one (a
  // separate Submission, category BOARD, linked via smcSourceSubmissionId below). Independent of
  // the ACCEPTED -> ROUTED -> CLOSED chain above — not a competing state.
  endorsedForBoard              Boolean              @default(false)
  endorsedForBoardAt            DateTime?
  endorsedForBoardById          String?
  // #A30 — the Board's own final outcome on a Board paper (distinct from individual Board Members'
  // Decision rows below, and from endorsedForBoard above, which only records the CEO's earlier
  // "send to Board" call). Set by the Corporate Secretariat once the configured approval rule
  // (src/lib/board/approvalRules.ts) is satisfied — same shape as endorsedForBoard/-At/-ById.
  boardOutcome                  String?
  boardOutcomeAt                DateTime?
  boardOutcomeById              String?
  // #A32 — the CEO's pre-meeting SEMC actions (Accept for Agenda / Return to Director / Request
  // More Information / Reject / Close), distinct from both the Secretariat's completeness-check
  // outcome (SubmissionReview.outcome) and the CEO's separate Board-vetting call
  // (endorsedForBoard/boardOutcome above). Free-text string, same reasoning as workflowStatus
  // (#A1) — see src/lib/submissions/semcReview.ts for the state list.
  ceoAgendaStatus               String?
  ceoAgendaStatusAt             DateTime?
  ceoAgendaStatusById           String?
  // #A32 — the two-step "SEMC recommends, CEO confirms" Board-escalation record the client's SEMC
  // spec asks for, kept distinct from endorsedForBoard (which remains the CEO's confirmation step
  // — semcEscalationRecommended is the new, earlier "SEMC recommends" half).
  semcEscalationRecommended     Boolean              @default(false)
  semcEscalationRecommendedAt   DateTime?
  semcEscalationRecommendedById String?
  submittedAt                   DateTime?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt

  versions        SubmissionVersion[]
  annexures       SubmissionAnnexure[]
  reviews         SubmissionReview[]
  decisions       Decision[]
  evidence        Evidence[]
  transitions     WorkflowTransition[]
  aiReviewResults AIReviewResult[]
  actionItems     ActionItem[]
  agendaItems     MeetingAgendaItem[]
  resolutions     Resolution[]
}

model SubmissionVersion {
  id            String     @id @default(cuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id])
  versionNumber Int
  snapshotJson  String // JSON snapshot of submission fields at this version
  createdAt     DateTime   @default(now())
  createdById   String
}

model SubmissionAnnexure {
  id                      String     @id @default(cuid())
  submissionId            String
  submission              Submission @relation(fields: [submissionId], references: [id])
  title                   String
  storageKey              String
  order                   Int        @default(0)
  carriedFromSubmissionId String? // set when transferred from the source SMC submission to a Board submission
}

model SubmissionReview {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  reviewerId   String
  reviewerRole String
  outcome      String // Accepted | Returned | Deferred | Rejected | Noted | Endorsed | EndorsedForBoard | Approved | ReferredBack | Closed
  comments     String?
  createdAt    DateTime   @default(now())
}

model WorkflowTransition {
  id             String               @id @default(cuid())
  entityType     String // Activity | Submission | Delegation | WeeklyManagerReport | Memo
  activityId     String?
  activity       Activity?            @relation(fields: [activityId], references: [id])
  submissionId   String?
  submission     Submission?          @relation(fields: [submissionId], references: [id])
  delegationId   String?
  delegation     Delegation?          @relation(fields: [delegationId], references: [id])
  // #A32 — additive FKs so Weekly Manager Reports and Memos get the same real transition-timeline
  // (not just AuditEvent JSON) every other workflowed entity in this codebase has.
  weeklyReportId String?
  weeklyReport   WeeklyManagerReport? @relation(fields: [weeklyReportId], references: [id])
  memoId         String?
  memo           Memo?                @relation(fields: [memoId], references: [id])
  fromState      String
  toState        String
  performedById  String
  performedAt    DateTime             @default(now())
  comment        String?
}

// #A30 — one row per Board Member's individual vote on a Decision Paper (decisionType values:
// Approve | Reject | Defer | RequestFurtherInformation | ApproveSubjectToConditions | Abstain |
// DeclareConflictOfInterest, still a free string — no migration needed to add more later, same
// reasoning as the original SMC/Board-registry values already listed below). `recordedById` is the
// deciding Board Member ("User" in the client's spec). Multiple rows per (submissionId,
// recordedById) are allowed — a changed vote is a new row, not an edit, per this codebase's
// append-only convention (#A6/#A27) — src/lib/board/decisions.ts reads only the latest per user.
model Decision {
  id                String     @id @default(cuid())
  submissionId      String
  submission        Submission @relation(fields: [submissionId], references: [id])
  meetingId         String
  meeting           Meeting    @relation(fields: [meetingId], references: [id])
  decisionType      String // Noted | Endorsed | Deferred | Rejected | EndorsedForBoard | Approved | ReferredBack | Closed | Approve | Reject | Defer | RequestFurtherInformation | ApproveSubjectToConditions | Abstain | DeclareConflictOfInterest
  decisionDate      DateTime
  recordedById      String
  notes             String?
  conditions        String? // "Conditions or follow-up actions" for Approve Subject to Conditions
  submissionVersion Int? // Submission.currentVersion snapshotted at decision time

  resolutions Resolution[]
  actionItems ActionItem[]
}

// #A30 — extended from a Decision-only concept to also support "create a resolution straight from
// an agenda item" (the client's own instruction) — decisionId is now optional; meetingId is now
// direct so a resolution is never orphaned from its meeting even without a formal Decision row.
model Resolution {
  id                      String             @id @default(cuid())
  decisionId              String?
  decision                Decision?          @relation(fields: [decisionId], references: [id])
  meetingId               String
  meeting                 Meeting            @relation(fields: [meetingId], references: [id])
  agendaItemId            String?
  agendaItem              MeetingAgendaItem? @relation(fields: [agendaItemId], references: [id])
  resolutionNumber        String             @unique
  subject                 String
  resolutionText          String
  status                  String             @default("DRAFT") // Draft | Proposed | Approved | Deferred | Rejected | InProgress | Completed | Closed
  responsiblePersonId     String?
  responsibleDepartmentId String?
  responsibleDepartment   Department?        @relation(fields: [responsibleDepartmentId], references: [id])
  dueDate                 DateTime?
  submissionId            String?
  submission              Submission?        @relation(fields: [submissionId], references: [id])
  followUpNotes           String?
  adoptedAt               DateTime           @default(now())

  actionItems ActionItem[]
}

// NOT_STARTED/AT_RISK/COMPLETED/CLOSED added for #A30's Board action tracker (the client's exact
// 6-value status set: Not Started/In Progress/At Risk/Overdue/Completed/Closed). OPEN/DONE are kept
// for the original addActionItem call site (src/lib/submissions/review.ts, unrelated to Board
// actions) — not renamed, to avoid touching that already-working code path.
enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  OVERDUE
  NOT_STARTED
  AT_RISK
  COMPLETED
  CLOSED
}

model ActionItem {
  id                 String           @id @default(cuid())
  decisionId         String?
  decision           Decision?        @relation(fields: [decisionId], references: [id])
  // Direct link so the CEO/Corporate Secretary can attach an action item straight to a paper
  // without first recording a formal Decision — see docs/mvp-directors-portal-plan.md#A18.
  submissionId       String?
  submission         Submission?      @relation(fields: [submissionId], references: [id])
  // #A30 additions below — the Board action tracker.
  resolutionId       String?
  resolution         Resolution?      @relation(fields: [resolutionId], references: [id])
  sourceMeetingId    String?
  sourceMeeting      Meeting?         @relation(fields: [sourceMeetingId], references: [id])
  departmentId       String?
  department         Department?      @relation(fields: [departmentId], references: [id])
  progressUpdate     String?
  evidenceStorageKey String?
  completionComment  String?
  createdById        String?
  description        String
  ownerId            String?
  dueDate            DateTime?
  status             ActionItemStatus @default(OPEN)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// CEO delegations (CEO -> Director only — see docs/assumptions-and-decisions.md#A29
// for why Director-to-Manager delegation chains are explicitly out of this milestone)
// ---------------------------------------------------------------------------

enum DelegationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Delegation {
  id                     String               @id @default(cuid())
  referenceNumber        String               @unique
  title                  String
  description            String
  responsibleDirectorId  String
  responsibleDirector    User                 @relation("DelegationDirector", fields: [responsibleDirectorId], references: [id])
  supportingDepartmentId String?
  supportingDepartment   Department?          @relation("DelegationSupportingDepartment", fields: [supportingDepartmentId], references: [id])
  supportingManagerId    String?
  supportingManager      User?                @relation("DelegationSupportingManager", fields: [supportingManagerId], references: [id])
  priority               DelegationPriority   @default(MEDIUM)
  startDate              DateTime
  dueDate                DateTime
  expectedOutcome        String
  requiredEvidence       String?
  confidentiality        ConfidentialityLevel @default(INTERNAL)
  // See src/lib/delegations/workflow.ts for the state graph. Free-text String, not an enum, for the
  // same reason as Submission.workflowStatus (#A1) — new states can be added without a migration.
  status                 String               @default("DRAFT")
  // #A32 — one of the client's 10 named delegation categories (Task/Work Activity/Event
  // Attendance/.../Other, src/lib/delegations/categories.ts), free-text so new categories never
  // need a migration, matching every other lookup-list-as-string in this codebase (#A9's
  // permittedPaperTypes reasoning).
  category               String?
  // #A32 — "Completion requires: Evidence or Report | Acknowledgement Only", enforced in
  // submitDelegationForReview() — see workflow.ts.
  completionRequirement  String               @default("EVIDENCE")
  createdById            String
  createdBy              User                 @relation("DelegationCreatedBy", fields: [createdById], references: [id])
  issuedAt               DateTime?
  acknowledgedAt         DateTime?
  closedAt               DateTime?
  closureDecision        String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  evidence    Evidence[]
  transitions WorkflowTransition[]
  recipients  DelegationRecipient[]
}

// #A32 — additional delegation recipients beyond the single accountable `responsibleDirectorId`
// (client: "several Directors with one accountable lead" / "a Manager, with the responsible
// Director automatically notified"). Deliberately additive rather than a rewrite of
// `responsibleDirectorId` — that field and its whole tested workflow stay the sole "accountable
// lead" driver; rows here are notified/visible parties, not independent state-machine actors, per
// docs/assumptions-and-decisions.md#A32.
model DelegationRecipient {
  id            String     @id @default(cuid())
  delegationId  String
  delegation    Delegation @relation(fields: [delegationId], references: [id])
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  recipientRole String     @default("DIRECTOR") // DIRECTOR | MANAGER
  addedById     String
  createdAt     DateTime   @default(now())

  @@unique([delegationId, userId])
}

// ---------------------------------------------------------------------------
// Notifications, audit, AI
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Append-only by convention: application code never issues UPDATE/DELETE against
// this table. See src/lib/audit/auditLog.ts.
model AuditEvent {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String?
  previousState  String? // JSON
  newState       String? // JSON
  correlationRef String?
  createdAt      DateTime @default(now())
}

// Milestone 1 closed-AI template-review output (src/lib/providers/aiReview/). Deliberately a
// separate model from AIGenerationRecord below — see #A14 — because this is structured
// review data (missing sections / warnings / suggested corrections as JSON arrays, a
// human-review status) rather than free-text generated prose. Advisory only: the AI never sets
// Submission.workflowStatus.
enum AIReviewOverallResult {
  PASS
  PASS_WITH_WARNINGS
  FAIL
}

model AIReviewResult {
  id                   String                @id @default(cuid())
  submissionId         String
  submission           Submission            @relation(fields: [submissionId], references: [id])
  templateId           String?
  template             Template?             @relation(fields: [templateId], references: [id])
  overallResult        AIReviewOverallResult
  missingSections      String // JSON string[]
  warnings             String // JSON string[]
  suggestedCorrections String // JSON string[]
  sourceReferences     String? // JSON string[] — e.g. section/heading names the findings cite
  reviewedAt           DateTime              @default(now())
  providerMode         String // mock | internal — see src/lib/providers/aiReview/interface.ts
  modelIdentifier      String? // set only when providerMode = internal
  humanReviewStatus    String                @default("PENDING") // PENDING | ACKNOWLEDGED — reviewer has seen these findings
}

model AIGenerationRecord {
  id            String    @id @default(cuid())
  purpose       String // ExecutiveSummary | BoardPaperSummary | CompletenessCheck | AchievementGrouping
  sourceType    String // Workplan | Activity | ManagementReport | Submission
  sourceIds     String // JSON array of source record ids the text was generated from
  generatedText String
  generatedAt   DateTime  @default(now())
  providerMode  String // mock | internal
  reviewedById  String?
  reviewStatus  String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED
  reviewedAt    DateTime?
}

// ---------------------------------------------------------------------------
// #A32 — CEO Portal: KPI/Milestone monitoring, Weekly Manager Reporting, Director Summaries,
// Forward-to-CEO object-level access, Memos & BAU Approvals, Financial routing config,
// Appointments. See docs/assumptions-and-decisions.md#A32 for the full design rationale.
// ---------------------------------------------------------------------------

// CEO-set milestones against a Director/department, monitored via the same reusable
// performance/risk service as DepartmentPerformance (src/lib/performance/riskService.ts) rather
// than a separately-coded traffic light. `validationStatus` is the client's exact 4-value CEO
// validation vocabulary; approved-target changes (target/dueDate edits after a milestone leaves
// DRAFT) are recorded as AuditEvents (action: MILESTONE_TARGET_CHANGED, carrying reason/previous/
// new in previousState/newState JSON, user+timestamp already implicit on AuditEvent) rather than a
// new audit model — reuses the existing append-only mechanism, see #A6/#A27 precedent.
model Milestone {
  id                    String     @id @default(cuid())
  referenceNumber       String     @unique
  title                 String
  description           String?
  departmentId          String
  department            Department @relation(fields: [departmentId], references: [id])
  responsibleDirectorId String
  responsibleDirector   User       @relation("MilestoneResponsibleDirector", fields: [responsibleDirectorId], references: [id])
  targetDescription     String
  startDate             DateTime?
  dueDate               DateTime
  progressPercent       Int        @default(0)
  // Submitted | Awaiting CEO Validation | Validated | Returned for Clarification — see
  // src/lib/performance/milestones.ts for the state graph.
  validationStatus      String     @default("SUBMITTED")
  directorComment       String?
  ceoComment            String?
  createdById           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  evidence Evidence[]
}

// The Weekly Manager Report the client's spec describes in full (14 fields), previously flagged in
// known-limitations.md as entirely unimplemented — this is the real model and workflow, not a
// repurposing of the pre-existing, still-unused ActivityUpdate (kept as-is; see
// docs/assumptions-and-decisions.md#A32 for why a new model was chosen over reviving that one).
model WeeklyManagerReport {
  id                    String               @id @default(cuid())
  referenceNumber       String               @unique
  reportingPeriodId     String
  reportingPeriod       ReportingPeriod      @relation(fields: [reportingPeriodId], references: [id])
  departmentId          String
  department            Department           @relation(fields: [departmentId], references: [id])
  managerId             String
  manager               User                 @relation("WeeklyReportManager", fields: [managerId], references: [id])
  activityId            String?
  activity              Activity?            @relation(fields: [activityId], references: [id])
  category              String // Project | BAU | Ad-hoc
  kpiKraContribution    String?
  progressPercent       Int                  @default(0)
  workCompleted         String
  milestonesAchieved    String?
  plannedWork           String?
  delays                String?
  risks                 String?
  decisionsRequired     String?
  dueDate               DateTime?
  // Draft | Submitted | Late | Under Director Review | Returned for Clarification |
  // Validated by Director | Included in Director Summary | Closed — see
  // src/lib/reporting/weeklyReportWorkflow.ts for the state graph.
  status                String               @default("DRAFT")
  isLate                Boolean              @default(false)
  lateJustification     String?
  directorReviewComment String?
  reviewedById          String?
  reviewedAt            DateTime?
  version               Int                  @default(1)
  supersedesId          String?              @unique
  supersedes            WeeklyManagerReport? @relation("WeeklyReportVersion", fields: [supersedesId], references: [id])
  supersededBy          WeeklyManagerReport? @relation("WeeklyReportVersion")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  evidence    Evidence[]
  transitions WorkflowTransition[]
}

// Director's consolidated, narrative per-department-per-period summary the CEO actually reads by
// default (client: "The CEO must not automatically receive access to every detailed Manager
// report"). Reuses the same `ceoValidationStatus` vocabulary as Milestone.validationStatus.
model DirectorSummary {
  id                   String          @id @default(cuid())
  departmentId         String
  department           Department      @relation(fields: [departmentId], references: [id])
  directorId           String
  director             User            @relation("DirectorSummaryDirector", fields: [directorId], references: [id])
  reportingPeriodId    String
  reportingPeriod      ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  keyAchievements      String?
  kpiKraProgressNote   String?
  milestonesNote       String?
  criticalActivities   String?
  delays               String?
  risks                String?
  decisionsRequired    String?
  nextPeriodPriorities String?
  lastReportingDate    DateTime?
  ceoValidationStatus  String          @default("SUBMITTED")
  ceoComment           String?
  createdById          String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([departmentId, reportingPeriodId])
}

// Generic "Forward to CEO" object-level access grant — the object-specific access primitive that
// docs/ceo-portal-requirements-review.md (WMR-5/RBAC-3) found entirely missing from the permission
// model. Polymorphic entityType/entityId, same generalization pattern as AuditEvent/Comment, so it
// applies to WeeklyManagerReport now and any future entity without a schema change.
// `entityVersion` pins the grant to the exact version forwarded, per the client's "access is
// granted only to the forwarded report/version" requirement.
model ReportAccessGrant {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  entityVersion   Int?
  grantedToUserId String
  grantedToUser   User     @relation("ReportAccessGrantedTo", fields: [grantedToUserId], references: [id])
  grantedById     String
  reason          String?
  createdAt       DateTime @default(now())
}

// CEO Memos & BAU Approvals — the model docs/ceo-portal-requirements-review.md (MEMO-1/MEMO-2)
// found entirely absent. `category` is one of the client's 13 named approval types (free string,
// src/lib/memos/categories.ts), `status` a table-driven graph (src/lib/memos/workflow.ts) matching
// this codebase's existing Submission/Delegation pattern. Comments reuse the existing polymorphic
// `Comment` model (entityType: "Memo") — no new comment table.
model Memo {
  id                    String     @id @default(cuid())
  referenceNumber       String     @unique
  category              String
  subject               String
  originatingDirectorId String
  originatingDirector   User       @relation("MemoOriginatingDirector", fields: [originatingDirectorId], references: [id])
  departmentId          String
  department            Department @relation(fields: [departmentId], references: [id])
  purpose               String
  background            String?
  requestedDecision     String
  recommendation        String?
  financialValue        Decimal?   @db.Decimal(14, 2)
  budgetCode            String?
  costCentre            String?
  delegationAuthority   String?
  priority              String     @default("MEDIUM")
  dueDate               DateTime?
  status                String     @default("DRAFT")
  currentVersion        Int        @default(1)
  delegatedReviewerId   String?
  delegatedReviewer     User?      @relation("MemoDelegatedReviewer", fields: [delegatedReviewerId], references: [id])
  createdById           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  evidence       Evidence[]
  whatsappTokens WhatsAppApprovalToken[]
  transitions    WorkflowTransition[]
}

// Configurable financial-approval routing thresholds — the client is explicit these must not be
// permanently hard-coded constants. Seeded with the 3 initial tiers (<=K50,000 / K50,000-K1m /
// >K1m) plus the CEO Office submission row; src/lib/finance/financialRouting.ts reads this table,
// never the raw numbers, to resolve which approval stage a Memo's financialValue requires.
model FinancialApprovalRule {
  id                    String   @id @default(cuid())
  label                 String
  minAmount             Decimal  @db.Decimal(14, 2)
  maxAmount             Decimal? @db.Decimal(14, 2)
  approvalStageSequence String // JSON string[] e.g. ["DIRECTOR","EXECUTIVE_VIEWER"]
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
}

// CEO/EO/PA appointment scheduling — behind the calendar provider interface
// (src/lib/providers/calendar/) the same way every other Microsoft 365 touchpoint in this codebase
// is (see #A3/#A7/#A13). `teamsMeetingUrl` is populated only by a real Graph-backed provider; the
// local mock leaves it null and says so in the UI rather than fabricating a fake link.
model Appointment {
  id              String   @id @default(cuid())
  title           String
  agenda          String?
  startAt         DateTime
  endAt           DateTime
  timezone        String   @default("Pacific/Port_Moresby")
  location        String?
  teamsMeetingUrl String?
  status          String   @default("SCHEDULED") // SCHEDULED | RESCHEDULED | CANCELLED | COMPLETED
  meetingNotes    String?
  organiserId     String
  organiser       User     @relation("AppointmentOrganiser", fields: [organiserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invitees AppointmentInvitee[]
  evidence Evidence[]
}

model AppointmentInvitee {
  id              String      @id @default(cuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  // Pending | Accepted | Declined | Clarification Requested | Alternate Nominated
  response        String      @default("PENDING")
  responseReason  String?
  alternateUserId String?
  respondedAt     DateTime?

  @@unique([appointmentId, userId])
}

// WhatsApp approval scaffolding only — see src/lib/providers/notifications/whatsappProvider.ts and
// docs/assumptions-and-decisions.md#A32 for why this deliberately stops short of a working
// inbound-command loop (no live Business API credentials, no public webhook route). This table
// exists so a real implementation has somewhere to write expiring, single-use, version-pinned
// tokens without a further migration — issueWhatsAppApprovalToken() creates rows; nothing consumes
// them yet.
model WhatsAppApprovalToken {
  id                  String    @id @default(cuid())
  memoId              String
  memo                Memo      @relation(fields: [memoId], references: [id])
  token               String    @unique
  documentVersion     Int
  phoneNumberSnapshot String?
  expiresAt           DateTime
  usedAt              DateTime?
  command             String?
  createdAt           DateTime  @default(now())
}
